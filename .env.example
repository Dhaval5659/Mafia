# Mafia Game Manager - Environment Configuration
# -------------------------------------------------------------
# Instructions for Gmail SMTP:
# 1. Sign in to your Google Account (https://myaccount.google.com).
# 2. Go to "Security" -> "2-Step Verification" and ensure it is turned ON.
# 3. Go to "App passwords" (https://myaccount.google.com/apppasswords).
# 4. Create a new app password (e.g. name it "Mafia App").
# 5. Google will generate a 16-character code (e.g. "abcd efgh ijkl mnop").
# 6. Copy this file to .env and paste your credentials below:

GMAIL_ADDRESS=your.email@gmail.com
GMAIL_APP_PASSWORD=abcdefghijklmnop

# Optional server configuration:
PORT=5000
DEBUG=False
